# Cole a URL de leitura do Neon aqui. Nunca envie o .env para o Git.
DATABASE_URL=
# Colunas reais de telemetry_logs (ajuste após rodar o diagnóstico)
OEE_TELEMETRY_TIME=recorded_at
OEE_TELEMETRY_STATE=machine_state
OEE_RUNNING_VALUE=RUNNING
OEE_THEORETICAL_PPM=10
# Se houver várias máquinas, use a coluna e o ID correspondentes
OEE_MACHINE_COLUMN=
OEE_MACHINE_VALUE=

# Servidor e origens HTTP(S) explícitas para o navegador
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
